# Base URL of the Gitea instance, without /api/v1.
GITEA_URL=https://git.example.com

# Server-side Gitea access token used only by the internal connector.
GITEA_TOKEN=

# Internal MCP service token between the Bratonien MCP host and this connector.
MCP_HTTP_TOKEN=

# Host-side connector binding behind the shared Bratonien MCP host.
MCP_PORT=8101
MCP_BIND_ADDRESS=127.0.0.1
MCP_CONTAINER_NAME=gitea-mcp
