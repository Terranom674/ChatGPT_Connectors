# Base URL of your Gitea instance, without /api/v1.
GITEA_URL=https://git.example.com

# Create a Gitea access token with only the permissions the connector needs.
# Never commit a real token.
GITEA_TOKEN=

# HTTP MCP settings.
# MCP_PORT is the host-side published port used by Docker Compose.
# MCP_BIND_ADDRESS can be 127.0.0.1 when the connector sits behind the shared Bratonien MCP host.
MCP_PORT=8000
MCP_BIND_ADDRESS=0.0.0.0

# Optional bearer token protecting the HTTP MCP endpoint.
# Leave empty only for trusted local development.
MCP_HTTP_TOKEN=

# Standalone/public OAuth mode.
# When configured, this connector publishes OAuth metadata itself and forwards
# authenticated OAuth bearer tokens to Gitea per request.
MCP_OAUTH_ISSUER=https://git.example.com
MCP_RESOURCE_URL=https://mcp.example.com/mcp

# Internal multi-connector-host mode.
# Set this to 1 only when the connector is bound to a trusted local interface and
# sits behind a central MCP host that performs the public authentication layer.
# In this mode MCP_OAUTH_ISSUER and MCP_RESOURCE_URL can remain empty here; the
# central host owns the public OAuth metadata and forwards the bearer token.
MCP_TRUST_FORWARDED_BEARER=

# Comma-separated browser origins allowed to call /mcp when an Origin header is present.
MCP_ALLOWED_ORIGINS=
