    "repoTrackedTimes": {
      "method": "GET",
      "path": "/repos/{owner}/{repo}/times",
      "summary": "List a repo's tracked times",
      "tag": "repository",
      "parameters": [
        {
          "name": "owner",
          "in": "path",
