# Manifold instance
MANIFOLD_URL=https://manifold.example.com
MANIFOLD_EMAIL=service-account@example.com
MANIFOLD_PASSWORD=change-me

# Internal MCP authentication between the shared host and this connector.
MCP_HTTP_TOKEN=replace-with-random-token

# Shared-host defaults
MCP_BIND_ADDRESS=127.0.0.1
MCP_PORT=8102
MCP_CONTAINER_NAME=manifold-mcp
