AFFINE_URL=https://affine.example.tld
AFFINE_WORKSPACE_ID=workspace-id
AFFINE_MCP_TOKEN=aff_mcp_v1.example.secret

# Recommended for self-hosted AFFiNE: the connector signs in itself, keeps the
# session cookie in memory and renews it when required. ChatGPT only sees this
# one connector and never receives these credentials.
AFFINE_EMAIL=connector@example.tld
AFFINE_PASSWORD=replace-with-affine-account-password
AFFINE_CLIENT_VERSION=0.27.0

# Optional override for installations that already provide a server-managed
# ordinary AFFiNE API/session credential. Leave both empty when using the
# connector-managed email/password login above.
AFFINE_API_AUTH_HEADER=
AFFINE_API_AUTH_VALUE=

MCP_HTTP_TOKEN=replace-me
MCP_BIND_ADDRESS=127.0.0.1
MCP_PORT=8104
MCP_CONTAINER_NAME=affine-mcp
