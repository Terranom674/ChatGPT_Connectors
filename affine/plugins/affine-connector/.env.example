AFFINE_URL=https://affine.example.tld
AFFINE_WORKSPACE_ID=workspace-id
AFFINE_MCP_TOKEN=aff_mcp_v1.example.secret
# Separate authentication for normal AFFiNE /api/* endpoints.
# The native aff_mcp_v1 token is intentionally not accepted on ordinary API routes.
# Examples: Authorization + Bearer/JWT value, or Cookie + a server-side session cookie.
AFFINE_API_AUTH_HEADER=Authorization
AFFINE_API_AUTH_VALUE=Bearer replace-with-affine-api-credential
MCP_HTTP_TOKEN=replace-me
MCP_BIND_ADDRESS=127.0.0.1
MCP_PORT=8104
MCP_CONTAINER_NAME=affine-mcp
